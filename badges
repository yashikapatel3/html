<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>My Badges</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cookie&family=Monoton&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #0F0E17;
            --card-bg: #1a1828b0;
            --card-border: rgba(255,255,255,0.07);
            --accent1: #FF6B6B;
            --accent2: #FFD93D;
            --accent3: #6BCB77;
            --accent4: #4D96FF;
            --accent5: #FF6BF5;
            --text-main: #FFFFFE;
            --text-soft: #A7A9BE;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Poppins', sans-serif;
            background-image: url("/photos/bb.jpg");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            -webkit-font-smoothing: antialiased;
            height: 100vh;
            /* padding: 80px 0 40px; */
            color: #f0f4f8;
        }

        /* ── FLOATING BLOBS ── */
        .blob {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            z-index: 0;
            animation: blobFloat 8s ease-in-out infinite alternate;
        }
        .blob-1 { width: 320px; height: 320px; background: rgba(255,107,107,0.08); top: 5%; left: -5%; animation-duration: 9s; }
        .blob-2 { width: 280px; height: 280px; background: rgba(77,150,255,0.09); top: 20%; right: -4%; animation-duration: 11s; animation-delay: -3s; }
        .blob-3 { width: 240px; height: 240px; background: rgba(255,217,61,0.07); bottom: 30%; left: 10%; animation-duration: 13s; animation-delay: -6s; }
        .blob-4 { width: 260px; height: 260px; background: rgba(107,203,119,0.07); bottom: 10%; right: 8%; animation-duration: 10s; animation-delay: -2s; }

        @keyframes blobFloat {
            from { transform: translate(0, 0) scale(1); }
            to   { transform: translate(30px, 20px) scale(1.08); }
        }

        .container { position: relative; z-index: 1; max-width: 1140px; }

        /* ── PAGE HEADER ── */
        .page-header {
            text-align: center;
            margin: 0px auto 40px;
            /* padding: 50px 0 55px; */
        }

        .header-badge-strip {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 18px;
        }

        .strip-dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            animation: dotBounce 1.4s ease-in-out infinite;
        }
        .strip-dot:nth-child(1) { background: var(--accent1); animation-delay: 0s; }
        .strip-dot:nth-child(2) { background: var(--accent2); animation-delay: 0.15s; }
        .strip-dot:nth-child(3) { background: var(--accent3); animation-delay: 0.30s; }
        .strip-dot:nth-child(4) { background: var(--accent4); animation-delay: 0.45s; }
        .strip-dot:nth-child(5) { background: var(--accent5); animation-delay: 0.60s; }

        @keyframes dotBounce {
            0%, 100% { transform: translateY(0); }
            50%       { transform: translateY(-7px); }
        }

        .medal-icon {
            width: 52px; height: 52px;
            filter: drop-shadow(0 0 14px rgba(255,217,61,0.6));
        }
        @media (max-width: 480px) {
            .medal-icon { width: 40px; height: 40px; }
        }

        .page-title {
            font-family: 'Monoton', sans-serif;
            font-size: clamp(2rem, 6vw, 3rem);
            text-shadow: #ffff 0px 0px 8px;
            font-weight: 500;
            letter-spacing: 3px;
            line-height: 1.1;
            margin-bottom: 12px;
            color: var(--text-main);
            animation: titlePop 0.7s cubic-bezier(0.34,1.56,0.64,1);
        }

        @keyframes titlePop {
            from { opacity: 0; transform: scale(0.8) translateY(-10px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }

        .page-subtitle {
            font-family: 'Cookie', sans-serif;
            font-size: 2rem;
            color: #f0f4f8;
            letter-spacing: 1px;
            font-weight: 500;
            animation: fadeUp 0.8s ease-out 0.3s both;
        }
        @media (max-width: 480px) {
            .page-title { font-size: 1.6rem; }
            .page-subtitle { font-size: 1rem; }
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ── CATEGORY CARD ── */
        .category-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            margin-bottom: 40px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 8px 40px rgba(0,0,0,0.35);
            animation: cardSlide 0.6s cubic-bezier(0.22,1,0.36,1) both;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .category-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 60px rgba(0,0,0,0.45);
        }

        @keyframes cardSlide {
            from { opacity: 0; transform: translateY(30px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .card-top-bar {
            height: 4px;
            background: linear-gradient(90deg, var(--accent1), var(--accent2), var(--accent3), var(--accent4), var(--accent5));
        }

        .category-card-inner {
            padding: clamp(22px, 4vw, 40px);
        }

        .category-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 22px;
        }

        .category-title {
            font-family: 'Baloo 2', sans-serif;
            font-size: clamp(1.4rem, 3.5vw, 2rem);
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: 0.5px;
        }

        .review-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 50px;
            padding: 6px 16px;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-soft);
        }

        .review-pill .count {
            font-family: 'Fredoka One', sans-serif;
            font-size: 1rem;
            color: var(--accent2);
        }
        @media (max-width: 480px) {
            .category-header { flex-direction: column; align-items: flex-start; }
            .category-title { font-size: 1.4rem; }
        }

        /* ── PROGRESS ── */
        .progress-wrap { margin-bottom: 32px; }

        .progress {
            height: 10px;
            border-radius: 99px;
            background: rgba(255,255,255,0.06);
            overflow: hidden;
            border: none;
        }

        .progress-bar {
            height: 100%;
            border-radius: 99px;
            background: linear-gradient(90deg, #FF6B6B, #FFD93D, #6BCB77, #4D96FF);
            background-size: 300% 100%;
            animation: grow 1.6s cubic-bezier(0.22,1,0.36,1), shimmer 3s linear infinite;
            box-shadow: 0 0 12px rgba(255,217,61,0.4);
        }

        @keyframes grow { from { width: 0 !important; } }
        @keyframes shimmer {
            0%   { background-position: 100% 0; }
            100% { background-position: -100% 0; }
        }

        /* ── BADGE GRID ── */
        .badge-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 200px));
            justify-content: space-evenly;
            /* gap: 32px; */
            padding: 10px 0;
        }

        @media (max-width: 768px) {
            .badge-grid {
                grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
                gap: 20px;
            }
        }

        @media (max-width: 480px) {
            .badge-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
        }

        /* ── BADGE BOX ── */
        .badge-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 28px 16px 22px;
            border-radius: 18px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s ease, background 0.3s ease;
            animation: badgePop 0.5s cubic-bezier(0.34,1.56,0.64,1) both;
        }

        .badge-box:nth-child(1) { animation-delay: 0.05s; }
        .badge-box:nth-child(2) { animation-delay: 0.10s; }
        .badge-box:nth-child(3) { animation-delay: 0.15s; }
        .badge-box:nth-child(4) { animation-delay: 0.20s; }
        .badge-box:nth-child(5) { animation-delay: 0.25s; }
        .badge-box:nth-child(6) { animation-delay: 0.30s; }

        @keyframes badgePop {
            from { opacity: 0; transform: scale(0.7) translateY(10px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }

        .badge-box:hover {
            transform: translateY(-10px) scale(1.06) rotate(-1deg);
            background: rgba(255,255,255,0.07);
        }

        /* Earned */
        .earned {
            background: rgba(255,217,61,0.07);
            border-color: rgba(255,217,61,0.3);
        }
        .earned:hover {
            background: rgba(255,217,61,0.12);
            box-shadow: 0 12px 30px rgba(255,217,61,0.2);
        }
        .earned .badge-img {
            box-shadow: 0 0 0 3px rgba(255,217,61,0.7), 0 0 20px rgba(255,217,61,0.4);
            animation: earnedPulse 2.5s ease-in-out infinite;
        }
        @keyframes earnedPulse {
            0%,100% { box-shadow: 0 0 0 3px rgba(255,217,61,0.7), 0 0 20px rgba(255,217,61,0.3); }
            50%      { box-shadow: 0 0 0 5px rgba(255,217,61,0.9), 0 0 35px rgba(255,217,61,0.5); }
        }
        .earned .badge-img-wrapper::after {
            content: "✓";
            position: absolute;
            top: -4px; right: -4px;
            width: clamp(22px,4vw,30px);
            height: clamp(22px,4vw,30px);
            background: linear-gradient(135deg, #6BCB77, #4ADE80);
            color: #fff;
            font-size: clamp(11px,2vw,14px);
            font-weight: 900;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            box-shadow: 0 3px 12px rgba(107,203,119,0.6);
            animation: checkPop 0.5s cubic-bezier(0.34,1.56,0.64,1) 0.3s both;
        }
        @keyframes checkPop {
            from { transform: scale(0) rotate(-180deg); }
            to   { transform: scale(1) rotate(0deg); }
        }

        /* Locked */
        .locked {
            background: rgba(255, 255, 255, 0.298);
            border-color: rgba(255,255,255,0.04);
        }
        .locked .badge-img {
            filter: grayscale(30%) brightness(0.3) blur(2px);
            opacity: 0.5;
        }
        .locked .badge-img-wrapper::after {
            content: "🔒";
            position: absolute;
            top: -4px; right: -4px;
            width: clamp(22px,4vw,30px);
            height: clamp(22px,4vw,30px);
            background: rgba(46, 46, 46, 0.9);
            font-size: clamp(11px,2vw,13px);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .locked .badge-name,
        .locked .badge-req { opacity: 0.35; }

        /* Unlocked */
        .unlocked {
            background: rgba(77, 151, 255, 0.331);
            border-color: rgba(77,150,255,0.25);
        }
        .unlocked:hover {
            box-shadow: 0 12px 30px rgba(77,150,255,0.18);
        }
        .unlocked .badge-img {
            box-shadow: 0 0 0 3px rgba(77,150,255,0.5), 0 0 20px rgba(77,150,255,0.3);
            animation: unlockedGlow 2.5s ease-in-out infinite;
        }
        @keyframes unlockedGlow {
            0%,100% { box-shadow: 0 0 0 3px rgba(77,150,255,0.5), 0 0 20px rgba(77,150,255,0.25); }
            50%      { box-shadow: 0 0 0 5px rgba(77,150,255,0.7), 0 0 30px rgba(77,150,255,0.4); }
        }
        .unlocked .badge-img-wrapper::after {
            content: "🔓";
            position: absolute;
            top: -4px; right: -4px;
            width: clamp(22px,4vw,30px);
            height: clamp(22px,4vw,30px);
            background: rgba(77,150,255,0.85);
            font-size: clamp(11px,2vw,13px);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            box-shadow: 0 3px 12px rgba(77,150,255,0.5);
        }

        /* ── BADGE IMG ── */
        .badge-img-wrapper {
            width: clamp(100px, 16vw, 150px);
            height: clamp(100px, 16vw, 150px);
            position: relative;
            margin-bottom: 16px;
            flex-shrink: 0;
        }
        .badge-img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            transition: transform 0.35s ease;
            display: block;
        }
        .badge-box:hover .badge-img { transform: scale(1.07); }

        /* ── BADGE INFO ── */
        .badge-name {
            font-family: 'Baloo 2', sans-serif;
            font-size: clamp(0.72rem, 1.6vw, 0.88rem);
            font-weight: 700;
            color: var(--text-main);
            line-height: 1.3;
            margin-bottom: 5px;
        }
        .badge-req {
            font-size: clamp(0.65rem, 1.4vw, 0.75rem);
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--accent2);
        }

        /* ── BACK BUTTON ── */
        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgb(243, 229, 213);
            color: rgb(243, 229, 213);
            text-decoration: none;
            font-family: 'Nunito', sans-serif;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 1px;
            padding: 10px 20px;
            border-radius: 50px;
            transition: all 0.25s ease;
            margin-bottom: 10px;
        }

        .back-btn:hover {
            background: rgba(255,255,255,0.12);
            border-color: rgba(255,255,255,0.25);
            color: #fff;
            transform: translateX(-4px);
        }

        .back-btn svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
            transition: transform 0.25s ease;
        }

        .back-btn:hover svg {
            transform: translateX(-3px);
        }
        @media (max-width: 480px) {
            .back-btn { font-size: 0.65rem; padding: 8px 12px;}
            .back-btn svg { width: 14px; height: 14px; }
        }

        /* ── FOOTER ── */
        .footer {
            font-family: Poppins, sans-serif;
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.95) 0%, rgba(44, 31, 46, 0.95) 100%) !important;
            border-top: 3px solid #F5A623;
            box-shadow: 0 -2px 10px rgba(245, 166, 35, 0.3);
            padding: 2rem 0;
            margin-top: auto;
            position: relative;
            overflow: hidden;
        }

        .footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg,
            transparent 0%,
            rgba(255, 255, 255, 0.3) 50%,
            transparent 100%);
        }

        /* Main Footer Container */
        .footer-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 3rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Left Side - Logo */
        .footer-left {
            display: flex;
            align-items: center;
            flex-shrink: 0;
        }

        .footer .xits-img {
            width: 150px;
            height: 100px;
            object-fit: contain;
            filter: drop-shadow(0 4px 12px rgba(255, 255, 255, 0.1));
            transition: transform 0.3s ease;
        }

        .footer .xits-img:hover {
            transform: scale(1.05);
        }

        /* Right Side - Content */
        .footer-right {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            justify-content: flex-end;
            text-align: end;
        }

        .footer p {
            color: #64748B;
            font-size: 0.95rem;
            font-family: 'Inter', 'Poppins', sans-serif;
            margin: 0;
            line-height: 1.6;
        }

        .footer-links {
            display: flex;
            align-items: end;
            text-align: end;
            justify-content: flex-end;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .footer-links a {
            color: #94A3B8;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            position: relative;
            font-family: 'Poppins', sans-serif;
            white-space: nowrap;
            text-align: end;
        }

        .footer-links a:hover {
            color: #F5A623;
            transform: translateY(-2px);
        }

        .footer-links a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -4px;
            left: 0;
            background-color: #F5A623;
            transition: width 0.3s ease;
        }

        .footer-links a:hover::after {
            width: 100%;
        }

        .copyright {
            color: #64748B;
            font-size: 0.85rem;
            margin-top: 0.5rem;
        }

        /* Responsive Design */
        @media (max-width: 992px) {
            .footer {
                padding: 1.75rem 0;
            }

            .footer-container {
                gap: 2rem;
            }

            .footer .xits-img {
                width: 85px;
                height: 70px;
            }

            .footer p {
                font-size: 0.9rem;
            }

            .footer-links {
                gap: 1.5rem;
            }

            .footer-links a {
                font-size: 0.85rem;
            }
        }

        @media (max-width: 768px) {
            .footer {
                padding: 1.5rem 0;
            }

            .footer-container {
                flex-direction: column;
                gap: 1.5rem;
                text-align: center;
            }

            .footer-left {
                justify-content: center;
            }

            .footer .xits-img {
                width: 75px;
                height: 62px;
            }

            .footer-right {
                align-items: center;
            }

            .footer-links {
                justify-content: center;
                gap: 1.5rem;
            }

            .footer p {
                font-size: 0.88rem;
            }
        }

        @media (max-width: 576px) {
            .footer {
                padding: 1.25rem 0;
            }

            .footer-container {
                gap: 1rem;
            }

            .footer .xits-img {
                width: 65px;
                height: 54px;
            }

            .footer-links {
                gap: 1rem;
            }

            .footer-links a {
                font-size: 0.8rem;
            }

            .footer p {
                font-size: 0.82rem;
            }

            .copyright {
                font-size: 0.78rem;
            }
        }

        @media (max-width: 400px) {
            .footer .xits-img {
                width: 55px;
                height: 46px;
            }

            .footer-links {
                gap: 0.75rem;
            }

            .footer-links a {
                font-size: 0.75rem;
                align-items: center;
            }

            .footer p {
                font-size: 0.78rem;
            }
        }
    </style>
</head>

<body>
<div class="blob blob-1"></div>
<div class="blob blob-2"></div>
<div class="blob blob-3"></div>
<div class="blob blob-4"></div>

<!-- NAVBAR -->
<div th:replace="~{fragments/navbar :: nav}"></div>

<div class="container py-4">

    <div class="pt-3 pb-0">
        <a th:href="@{/profile}" class="back-btn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            Back
        </a>
    </div>

    <div class="page-header">
        <div class="header-badge-strip">
            <div class="strip-dot"></div>
            <div class="strip-dot"></div>
            <img src="/photos/medal_16768837.gif" class="medal-icon" alt="medal">
            <div class="strip-dot"></div>
            <div class="strip-dot"></div>

            <h1 class="page-title">My Badges</h1>
        </div>
        <p class="page-subtitle">✨ Collect them all — show off your movie cred ✨</p>
    </div>

    <div th:each="entry : ${categoryBadgesMap}">
        <div class="category-card">
            <div class="card-top-bar"></div>
            <div class="category-card-inner">

                <div class="category-header">
                    <div class="category-title" th:text="${entry.key.name}"></div>
                    <div class="review-pill">
                        Reviews: <span class="count" th:text="${reviewCountMap[entry.key.id]}"></span>
                    </div>
                </div>

                <div class="progress-wrap">
                    <div class="progress">
                        <div class="progress-bar" th:style="'width:' + ${progressMap[entry.key.id]} + '%'"></div>
                    </div>
                </div>

                <div class="badge-grid">
                    <div th:each="badge : ${entry.value}" th:class="'badge-box ' +
                             (${earnedBadgeIds.contains(badge.badgeId)} ? 'earned' :
                             (${reviewCountMap[entry.key.id]} >= ${badge.requiredReviews} ? 'unlocked' : 'locked'))">

                        <div class="badge-img-wrapper">
                            <img class="badge-img" th:src="@{/icon/{id}(id=${badge.badgeId})}" alt="badge">
                        </div>

                        <div class="badge-info">
                            <div class="badge-name" th:text="${badge.name}"></div>
                            <div class="badge-req">
                                <span th:text="${badge.requiredReviews}"></span> Reviews
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

