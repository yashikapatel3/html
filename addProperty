                        <span class="rp-tp"><svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>Intercom<span class="ck"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span></span>
                    </label>
                </div>
            </div>
        </div>

        <!-- COMMERCIAL SPECIFIC amenities -->
        <div id="rp-com-amen" class="rp-cond">
            <div class="amen-group">
                <div class="amen-group-hdr">Commercial</div>
                <div class="rp-tg">
                    <label class="rp-ti">
                        <input type="checkbox" name="amenitiesReception" value="true"/>
                        <span class="rp-tp"><svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>Reception Area<span class="ck"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span></span>
                    </label>
                    <label class="rp-ti">
                        <input type="checkbox" name="amenitiesConference" value="true"/>
                        <span class="rp-tp"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>Conference Room<span class="ck"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span></span>
                    </label>
                    <label class="rp-ti">
                        <input type="checkbox" name="amenities247Access" value="true"/>
                        <span class="rp-tp"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>24/7 Access<span class="ck"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span></span>
                    </label>
                    <label class="rp-ti" id="amen-loading">
                        <input type="checkbox" name="amenitiesLoadingDock" value="true"/>
                        <span class="rp-tp"><svg viewBox="0 0 24 24"><path d="M2 20V8l10-6 10 6v12H2z"/><rect x="9" y="14" width="6" height="6"/></svg>Loading Dock<span class="ck"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span></span>
                    </label>
                    <label class="rp-ti" id="amen-cafeteria">
                        <input type="checkbox" name="amenitiesCafeteria" value="true"/>
                        <span class="rp-tp"><svg viewBox="0 0 24 24"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>Cafeteria<span class="ck"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span></span>
                    </label>
                    <label class="rp-ti">
                        <input type="checkbox" name="amenitiesPowerBackup" value="true"/>
                        <span class="rp-tp"><svg viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>Power Backup<span class="ck"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span></span>
                    </label>
                    <label class="rp-ti">
                        <input type="checkbox" name="amenitiesFireSafety" value="true"/>
                        <span class="rp-tp"><svg viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 18c-4.4 0-8-3.6-8-8s3.6-8 8-8 8 3.6 8 8-3.6 8-8 8z"/><path d="M9 12l2 2 4-4"/></svg>Fire Safety<span class="ck"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span></span>
                    </label>
                    <label class="rp-ti">
                        <input type="checkbox" name="amenitiesCCTV" value="true"/>
                        <span class="rp-tp"><svg viewBox="0 0 24 24"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>CCTV Surveillance<span class="ck"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span></span>
                    </label>
                    <label class="rp-ti">
                        <input type="checkbox" name="amenitiesServerRoom" value="true"/>
                        <span class="rp-tp"><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>Server Room<span class="ck"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span></span>
                    </label>
                    <label class="rp-ti">
                        <input type="checkbox" name="amenitiesHouseKeeping" value="true"/>
                        <span class="rp-tp"><svg viewBox="0 0 24 24"><path d="M3 22V12a9 9 0 0118 0v10"/><path d="M9 22v-4h6v4"/></svg>Housekeeping<span class="ck"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span></span>
                    </label>
                </div>
            </div>
        </div>

    </aside>
</div>

<script>
    // FIX 3: currentPropType declare kiya
    let currentPropType = '';

    // ── AMENITY RULES per property type ──
    const AMENITY_RULES = {
        'Plot/Land': { hideFloor:true, hideElectricity:true, hideWater:true, hideLift:true, hideWifi:true, hideBathroom:true, hideAdditional:true },
        'Warehouse': { hideWifi:true, hideBathroom:true },
        'Cold Storage': { hideWifi:true, hideBathroom:true },
    };

    function applyAmenityRules(type) {
        const rules = AMENITY_RULES[type] || {};
        const tog = (id, hide) => { const el=document.getElementById(id); if(el) el.classList.toggle('hidden', !!hide); };
        document.getElementById('floorField').classList.toggle('hidden', !!rules.hideFloor);
        tog('amen-electricity', rules.hideElectricity);
        tog('amen-water', rules.hideWater);
        tog('amen-lift', rules.hideLift);
        tog('amen-wifi', rules.hideWifi);
        tog('amen-bathroom', rules.hideBathroom);
        tog('rp-additional', rules.hideAdditional);
    }

    document.querySelectorAll('input[name="propertyType"]').forEach(r => {
        r.addEventListener('change', () => {
            currentPropType = r.value;
            applyAmenityRules(r.value);
        });
    });

    // ── FURNISHED STATUS PANELS ──
    const furnMap = {
        'furn-full':  'panel-fully',
        'furn-semi':  'panel-semi',
        'furn-un':    'panel-unfurnished'
    };

    document.querySelectorAll('input[name="furnishedStatus"]').forEach(r => {
        r.addEventListener('change', function() {
            Object.values(furnMap).forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.remove('show');
            });
            const target = furnMap[this.id];
            if (target) {
                const panel = document.getElementById(target);
                if (panel) panel.classList.add('show');
            }
        });
    });

    function syncAmenities() {
        const map = {
            'amenitiesParking':          'h-amenitiesParking',
            'amenitiesSecurity':         'h-amenitiesSecurity',
            'amenitiesLift':             'h-amenitiesLift',
            'amenitiesWifi':             'h-amenitiesWifi',
            'amenitiesGarden':           'h-amenitiesGarden',
            'amenitiesAttachedBathroom': 'h-amenitiesAttachedBathroom',
            'amenitiesTerrace':          'h-amenitiesTerrace',
        };
        Object.entries(map).forEach(([name, hiddenId]) => {
            const cb = document.querySelector(`input[type=checkbox][name="${name}"]:checked`);
            document.getElementById(hiddenId).value = cb ? 'true' : 'false';
        });
    }

    // ── SECTION TOGGLE ──
    function tog(bodyId, arrId, n) {
        const body = document.getElementById(bodyId);
        const arr  = document.getElementById(arrId);
        const isCol = body.classList.toggle('col');
        arr.style.transform = isCol ? '' : 'rotate(180deg)';
        if (!isCol) syncStep(n);
    }

    function goStep(n) {
        const b = document.getElementById('b'+n);
        const a = document.getElementById('a'+n);
        if (b.classList.contains('col')) { b.classList.remove('col'); a.style.transform = 'rotate(180deg)'; }
        document.getElementById('sec'+n).scrollIntoView({behavior:'smooth',block:'start'});
        syncStep(n);
    }

    function syncStep(active) {
        document.querySelectorAll('.sb-step').forEach((s,i) => {
            s.classList.remove('active','done');
            if (i+1 < active) s.classList.add('done');
            if (i+1 === active) s.classList.add('active');
        });
        const pct = Math.round((active/5)*100);
        document.getElementById('progFill').style.width = pct+'%';
        document.getElementById('progText').textContent = 'Step '+active+' of 5';
    }

    // ── CATEGORY SELECTION ──
    function pickCategory(cat) {
        ['res-types','com-types'].forEach(id => document.getElementById(id).classList.remove('show'));
        document.getElementById('cat-hint').style.display = 'none';
        document.querySelectorAll('input[name="propertyType"]').forEach(r => r.checked = false);
        applyAmenityRules('');
        currentPropType = '';

        document.getElementById('rp-no-cat').style.display = 'none';
        document.getElementById('rp-common').classList.add('show');
        document.getElementById('rp-res-amen').classList.remove('show');
        document.getElementById('rp-com-amen').classList.remove('show');

        if (cat === 'res') {
            document.getElementById('res-types').classList.add('show');
            document.getElementById('rp-res-amen').classList.add('show');

            // FIX 4: disabled nahi karo, sirf value clear karo
            document.getElementById('noOfRoom').value = '';
            document.getElementById('noOfMember').value = '';

        } else if (cat === 'com') {
            document.getElementById('com-types').classList.add('show');
            document.getElementById('rp-com-amen').classList.add('show');

            // FIX 4: disabled ki jagah value clear karo (disabled fields DB mein null bhejte hain)
            document.getElementById('noOfRoom').value = '0';
            document.getElementById('noOfMember').value = '0';
        }
    }

    document.querySelectorAll('input[name="categoryId"]').forEach(r => {
        r.addEventListener('change', () => pickCategory(r.value === '1' ? 'res' : 'com'));
        if (r.checked) pickCategory(r.value === '1' ? 'res' : 'com');
    });

    // ── AUTO AREA ──
    function calcArea() {
        const l = parseFloat(document.getElementById('fLength').value) || 0;
        const w = parseFloat(document.getElementById('fWidth').value) || 0;
        const area = l * w;
        const res = document.getElementById('areaResult');
        if (l > 0 && w > 0) {
            document.getElementById('areaVal').textContent = area.toFixed(2);
            document.getElementById('fArea').value = area.toFixed(2);
            res.classList.add('show');
        } else {
            res.classList.remove('show');
            document.getElementById('fArea').value = '';
        }
    }
    document.getElementById('fLength').addEventListener('input', calcArea);
    document.getElementById('fWidth').addEventListener('input', calcArea);

    // ── VALIDATION ──
    function setErr(fieldId, errId, show) {
        const f = document.getElementById(fieldId), e = document.getElementById(errId);
        if (f) f.classList.toggle('error', show);
        if (e) e.classList.toggle('show', show);
    }

    function validateForm() {
        let errors = [], valid = true;

        const catOk = !!document.querySelector('input[name="categoryId"]:checked');
        document.getElementById('e-category').classList.toggle('show', !catOk);
        if (!catOk) { valid = false; errors.push('Category'); }

        const ptOk = !!document.querySelector('input[name="propertyType"]:checked');
        document.getElementById('e-propType').classList.toggle('show', !ptOk);
        if (!ptOk) { valid = false; errors.push('Property Type'); }

        const lt = document.getElementById('fListingType');
        const ltOk = lt && lt.value !== '';
        setErr('fListingType','e-listingType',!ltOk);
        if (!ltOk) { valid = false; errors.push('Listing Type'); }

        const city = document.getElementById('fCity');
        const cityOk = city && city.value.trim() !== '';
        setErr('fCity','e-city',!cityOk);
        if (!cityOk) { valid = false; errors.push('City'); }

        const price = document.getElementById('fPrice');
        const priceOk = price && price.value.trim() !== '' && parseFloat(price.value) > 0;
        setErr('fPrice','e-price',!priceOk);
        if (!priceOk) { valid = false; errors.push('Price'); }

        const banner = document.getElementById('valBanner');
        const list   = document.getElementById('valList');
        if (!valid) {
            list.innerHTML = errors.map(e => `<li>${e}</li>`).join('');
            banner.classList.add('show');
            // FIX 2: pnameOk undefined tha, ab sahi logic hai
            if (!catOk || !ptOk) openSec(1);
            else if (!ltOk) openSec(2);
            else if (!cityOk) openSec(3);
            else if (!priceOk) openSec(4);
            banner.scrollIntoView({behavior:'smooth', block:'start'});
        } else {
            banner.classList.remove('show');
        }
        return valid;
    }

    function openSec(n) {
        const b = document.getElementById('b'+n), a = document.getElementById('a'+n);
        if (b && b.classList.contains('col')) { b.classList.remove('col'); if(a) a.style.transform = 'rotate(180deg)'; }
    }

    // ── CONFETTI ──
    function launchConfetti() {
        const container = document.getElementById('confettiContainer');
        container.innerHTML = '';
        const colors = ['#1a6b72','#e8a44a','#38a169','#3182ce','#805ad5','#e53e3e','#dd6b20','#2a8a93'];
        for (let i = 0; i < 60; i++) {
            const piece = document.createElement('div');
            piece.className = 'confetti-piece';
            piece.style.cssText = `
                left: ${Math.random() * 100}%;
                background: ${colors[Math.floor(Math.random() * colors.length)]};
                width: ${4 + Math.random() * 8}px;
                height: ${4 + Math.random() * 8}px;
                border-radius: ${Math.random() > 0.5 ? '50%' : '2px'};
                animation-duration: ${1.2 + Math.random() * 1.5}s;
                animation-delay: ${Math.random() * 0.6}s;
                opacity: 1;
            `;
            container.appendChild(piece);
        }
    }

    // ── IMAGE PREVIEW + PRIMARY STAR ──
    (function () {
        const fileInput     = document.getElementById('fileInput');
        const grid          = document.getElementById('imgPreviewGrid');
        const thumbRow      = document.getElementById('imgThumbRow');
        const noImgNote     = document.getElementById('noImgNote');
        // FIX 1: submitBtn ID added on button, so this now works correctly
        const submitBtn     = document.getElementById('submitBtn');
        const primaryHidden = document.getElementById('primaryImageIndex');

        let selectedFiles = [];
        let primaryIdx    = 0;

        fileInput.addEventListener('change', function () {
            selectedFiles = Array.from(this.files).filter(f => f.type.startsWith('image/') || f.type.startsWith('video/'));
            primaryIdx = 0;
            primaryHidden.value = 0;
            renderPreviews();
            toggleSubmit();
        });

        function renderPreviews() {
            thumbRow.innerHTML = '';
            if (!selectedFiles.length) {
                grid.style.display = 'none';
                noImgNote.style.display = 'flex';
                return;
            }
            grid.style.display = 'block';
            noImgNote.style.display = 'none';

            selectedFiles.forEach(function (file, i) {
                const wrap = document.createElement('div');
                wrap.className = 'thumb-wrap';
                wrap.style.border = '2px solid ' + (i === primaryIdx ? 'var(--accent)' : 'var(--border)');

                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.alt = 'Property image ' + (i + 1);
                        wrap.insertBefore(img, wrap.firstChild);
                    };
                    reader.readAsDataURL(file);
                } else {
                    const ph = document.createElement('div');
                    ph.style.cssText = 'width:100%;height:100%;background:var(--teal-light);display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--teal);font-weight:600;';
                    ph.textContent = 'VIDEO';
                    wrap.appendChild(ph);
                }

                const star = document.createElement('button');
                star.type = 'button';
                star.className = 'thumb-star';
                star.title = 'Set as primary image';
                star.textContent = i === primaryIdx ? '★' : '☆';
                star.style.color = i === primaryIdx ? '#f5c518' : '#fff';
                star.addEventListener('click', function () {
                    primaryIdx = i;
                    primaryHidden.value = i;
                    renderPreviews();
                });
                wrap.appendChild(star);

                if (i === primaryIdx) {
                    const badge = document.createElement('div');
                    badge.className = 'thumb-primary-badge';
                    badge.textContent = 'Primary';
                    wrap.appendChild(badge);
                }

                thumbRow.appendChild(wrap);
            });
        }

        function toggleSubmit() {
            if (submitBtn) submitBtn.disabled = selectedFiles.length === 0;
        }
    })();

    // ── SUBMIT ──
    function handleSubmit() {
        if (!validateForm()) return;
        syncAmenities();

        const ensureVal = (id, fb) => { const el=document.getElementById(id); if(el && !el.value.trim()) el.value=fb; };
        ensureVal('fDesc', 'N/A');
        document.querySelectorAll('input[name="location"]').forEach(el => { if(!el.value.trim()) el.value='N/A'; });
        document.querySelectorAll('input[name="landmark"]').forEach(el => { if(!el.value.trim()) el.value='N/A'; });
        const fi = document.querySelector('input[name="floor"]'); if(fi && !fi.value.trim()) fi.value='0';
        const wi = document.getElementById('fWidth'); if(wi && !wi.value.trim()) wi.value='0';
        const li = document.getElementById('fLength'); if(li && !li.value.trim()) li.value='0';

        document.getElementById('successModal').classList.add('open');
        launchConfetti();

        setTimeout(() => {
            const form = document.getElementById('propForm');
            form.method = 'POST';  // ← YEH ADD KARO
            form.submit();
        }, 1800);
    }

    function closeModal() {
        document.getElementById('successModal').classList.remove('open');
        resetAll();
        document.getElementById('propForm').reset();
    }

    // ── RESET ──
    function resetAll() {
        ['res-types','com-types'].forEach(id => document.getElementById(id).classList.remove('show'));
        document.getElementById('cat-hint').style.display = 'flex';
        document.getElementById('valBanner').classList.remove('show');
        document.getElementById('areaResult').classList.remove('show');
        document.querySelectorAll('.error').forEach(el => el.classList.remove('error'));
        document.querySelectorAll('.err-msg').forEach(el => el.classList.remove('show'));
        document.getElementById('rp-no-cat').style.display = 'block';
        document.getElementById('rp-common').classList.remove('show');
        document.getElementById('rp-res-amen').classList.remove('show');
        document.getElementById('rp-com-amen').classList.remove('show');
        document.getElementById('imgPreviewGrid').style.display = 'none';
        document.getElementById('imgThumbRow').innerHTML = '';
        document.getElementById('noImgNote').style.display = 'flex';
        document.getElementById('primaryImageIndex').value = '0';
        const submitBtn = document.getElementById('submitBtn');
        if (submitBtn) submitBtn.disabled = true;
        Object.values(furnMap).forEach(id => {
            const el = document.getElementById(id);
            if (el) el.classList.remove('show');
        });
        applyAmenityRules('');
        // FIX 3: currentPropType reset
        currentPropType = '';
    }

    // ── SIDEBAR SYNC ──
    [1,2,3,4,5].forEach(n => {
        const el = document.getElementById('sec'+n);
        if (!el) return;
        new IntersectionObserver(e => { if(e[0].isIntersecting) syncStep(n); },{threshold:0.4}).observe(el);
    });

    // Clear errors on change
    document.getElementById('fListingType').addEventListener('change',
        () => setErr('fListingType','e-listingType',false));
    document.getElementById('fCity').addEventListener('input',
        () => setErr('fCity','e-city',false));
    document.getElementById('fPrice').addEventListener('input',
        () => setErr('fPrice','e-price',false));
    document.querySelectorAll('input[name="categoryId"]').forEach(r =>
    r.addEventListener('change', () => document.getElementById('e-category').classList.remove('show')));
    document.querySelectorAll('input[name="propertyType"]').forEach(r =>
    r.addEventListener('change', () => document.getElementById('e-propType').classList.remove('show')));
</script>
</body>
</html>
